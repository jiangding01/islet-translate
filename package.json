{
  "name": "islet-translate",
  "description": "网页翻译 Chrome 扩展",
  "version": "0.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangding01/islet-translate.git"
  },
  "homepage": "https://github.com/jiangding01/islet-translate#readme",
  "bugs": {
    "url": "https://github.com/jiangding01/islet-translate/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt --browser chrome",
    "build": "wxt build --browser chrome",
    "zip": "wxt zip --browser chrome",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:build": "node scripts/check-build.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:i18n && npm run check:contrast && npm run test && npm run build && npm run check:build && npm run check:size",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.2",
    "@wxt-dev/i18n": "^0.2.9",
    "idb": "^8.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
